    "RemeasureReady": {
      "additionalProperties": false,
      "description": "The Integrator's paired remeasure of a rebased candidate on baseline@k (D74).\n\nIt goes to the Integrator only; it never creates a follow-up task for a worker.\nAs in ResultReady, score and paired are None when the run was void, and\nconstraint_ok False means the remeasure was refuted. per_seed is the run's own\nper-seed scores: result.json is written once per hash, so a second measurement\nof the same content and target (a reverted baseline measured on the daily set\nand then on the audit set) has no record of its own there. dataset says which\nset the judge ran it on (D72).",
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "parent_candidate": {
          "title": "Parent Candidate",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "baseline": {
          "title": "Baseline",
          "type": "string"
        },
        "paired": {
          "anyOf": [
            {
              "$ref": "#/$defs/Paired"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "constraint_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Ok"
        },
        "per_seed": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Per Seed",
          "type": "array"
        },
        "dataset": {
          "default": "dev",
          "enum": [
            "dev",
            "audit"
          ],
          "title": "Dataset",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "candidate",
        "parent_candidate",
        "claim_id",
        "baseline",
        "paired",
        "score",
        "level"
      ],
      "title": "RemeasureReady",
      "type": "object"
    },
    "ResultReady": {
      "additionalProperties": false,
      "description": "approach is the candidate's approach, so the follow-up task can name it (D28).\n\nconstraint_ok False means the result was refuted by a constraint or a\npost-result gate (D54): paired is then a measurement, never a gain. score and\npaired are None when the run was void, for example a candidate that crashed or\ntimed out on a seed; constraint_ok is then False too.",
      "properties": {
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "approach": {
          "title": "Approach",
          "type": "string"
        },
        "submitter": {
          "title": "Submitter",
          "type": "string"
        },
        "submitter_checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Submitter Checkpoint"
        },
        "baseline": {
          "title": "Baseline",
          "type": "string"
        },
        "paired": {
          "anyOf": [
            {
              "$ref": "#/$defs/Paired"
            },
            {
              "type": "null"
            }
          ]
        },
        "per_item": {
          "title": "Per Item",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "constraint_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Ok"
        }
      },
      "required": [
        "candidate",
        "claim_id",
        "approach",
        "submitter",
        "submitter_checkpoint",
        "baseline",
        "paired",
        "per_item",
        "score",
        "level"
      ],
      "title": "ResultReady",
      "type": "object"
    },
