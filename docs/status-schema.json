    "Paired": {
      "additionalProperties": false,
      "description": "Paired difference between a candidate and the baseline it was built on (D73).\n\nn_reps counts only remeasures the eval service ran itself; cache hits do not count.",
      "properties": {
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "se": {
          "minimum": 0,
          "title": "Se",
          "type": "number"
        },
        "n_items": {
          "minimum": 0,
          "title": "N Items",
          "type": "integer"
        },
        "n_reps": {
          "minimum": 0,
          "title": "N Reps",
          "type": "integer"
        }
      },
      "required": [
        "mean",
        "se",
        "n_items",
        "n_reps"
      ],
      "title": "Paired",
      "type": "object"
    },
