{
  "name": "@vlah/observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/replay.test.ts",
    "record": "cd .. && uv run python -m ui.record_replay",
    "test:recording": "cd .. && uv run pytest -q ui/test_record_replay.py ui/test_event_contract.py",
    "test:browser": "node --experimental-strip-types browser.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
